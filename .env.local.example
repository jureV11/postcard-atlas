# Copy to .env. Use URL-safe random values for both secrets.
DB_PASSWORD=replace-with-long-random-url-safe-password
API_JWT_SECRET=replace-with-at-least-32-random-characters
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-cloudflare-access-application-audience
HOST_PORT=3000
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres

# Optional phone notifications and profile flags.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# PUSH_SECRET=
# PRIDE_FLAG_NAMES=
