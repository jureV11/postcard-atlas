# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" key (or the newer "publishable" key) — safe to expose, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: anyone whose name contains one of these (comma-separated, any case)
# gets a rainbow pride flag in their profile's flag burst instead of their country's.
# PRIDE_FLAG_NAMES=

# Optional: phone notifications. Don't fill these in by hand — run
#   node scripts/push-keys.mjs https://your-site --env .env.local --sql push-setup.local.sql
# (see HOSTING.md → Phone app and notifications).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# PUSH_SECRET=
